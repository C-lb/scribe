GROQ_API_KEY=
ANTHROPIC_API_KEY=
SCRIBE_CHUNK_SECONDS=20
SCRIBE_SUMMARY_INTERVAL_MINUTES=5
SCRIBE_RUNNING_MODEL=claude-opus-5
SCRIBE_FINAL_MODEL=claude-opus-5
SCRIBE_KEEP_AUDIO=true
SCRIBE_LANGUAGE=en
SCRIBE_PORT=4747
# Test suites override this; leave unset to use ~/scribe/sessions
# SCRIBE_SESSIONS_DIR=
# Where finished sessions are mirrored into an Obsidian vault, one folder
# per category. Leave unset to turn the export off entirely.
# SCRIBE_OBSIDIAN_VAULT=
# Speech-to-text engine: auto (Voicebox if it is running, else Groq), voicebox, or groq.
SCRIBE_STT=auto
# Where the Voicebox desktop app listens. Only change this if you moved its port.
SCRIBE_VOICEBOX_URL=http://127.0.0.1:17493
# Whisper size for Voicebox, e.g. whisper-turbo. Leave empty for Voicebox's default.
SCRIBE_VOICEBOX_MODEL=
