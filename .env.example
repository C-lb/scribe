GROQ_API_KEY=
ANTHROPIC_API_KEY=
SCRIBE_CHUNK_SECONDS=20
SCRIBE_SUMMARY_INTERVAL_MINUTES=5
SCRIBE_RUNNING_MODEL=claude-opus-5
SCRIBE_FINAL_MODEL=claude-opus-5
SCRIBE_KEEP_AUDIO=true
SCRIBE_LANGUAGE=en
SCRIBE_PORT=4747
# Test suites override this; leave unset to use ~/scribe/sessions
# SCRIBE_SESSIONS_DIR=
# Where finished sessions are mirrored into an Obsidian vault, one folder
# per category. Leave unset to turn the export off entirely.
# SCRIBE_OBSIDIAN_VAULT=
# Speech-to-text engine: auto (local Whisper once loaded, Groq until then), local, or groq.
SCRIBE_STT=auto
# Loopback port for the local Whisper sidecar (stt/whisper_server.py).
SCRIBE_LOCAL_STT_PORT=4748
# MLX Whisper weights the sidecar loads. Smaller and faster: mlx-community/whisper-base-mlx
SCRIBE_LOCAL_MODEL=mlx-community/whisper-large-v3-turbo
